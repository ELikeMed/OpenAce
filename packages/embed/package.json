{
  "name": "@openace/embed",
  "version": "1.0.3",
  "description": "Embed Ace — your AI executive assistant — directly into any web app",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "bin": {
    "ace-init": "./bin/ace-init.js",
    "openace-init": "./bin/ace-init.js"
  },
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./server": {
      "import": "./src/server/createAceServer.js",
      "default": "./src/server/createAceServer.js"
    },
    "./widget": {
      "import": "./src/client/AceWidget.jsx",
      "default": "./src/client/AceWidget.jsx"
    },
    "./css": "./src/client/styles/ace-widget.css"
  },
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "dev": "node examples/nextjs/server.js",
    "init": "node bin/ace-init.js"
  },
  "keywords": ["ai", "assistant", "embed", "widget", "seo", "blog", "openace", "chatbot"],
  "author": "OpenAce AI",
  "license": "MIT",
  "homepage": "https://openaceai.com/embed",
  "repository": {
    "type": "git",
    "url": "https://github.com/openace-ai/OpenAce.git",
    "directory": "packages/embed"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "marked": "^12.0.0",
    "node-cron": "^3.0.3"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "openai": "^4.28.0",
    "nodemailer": "^8.0.1",
    "twilio": "^5.12.2",
    "stripe": "^17.7.0",
    "pdf-parse": "^2.4.5",
    "mammoth": "^1.11.0"
  },
  "devDependencies": {
    "rollup": "^4.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-terser": "^0.4.0"
  }
}
