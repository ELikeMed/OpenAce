# Config files (contain API keys)
config/openace.config.json
config/google-credentials.json
config/zoom-credentials.json
.env
.env.local

# Keep example configs
!config/openace.config.example.json
!config/google-credentials.example.json

# User projects (created by users, root only)
/projects/
!/projects/.gitkeep

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Build output
/dist/
build/
*.tgz

# Dashboard build (rebuilt on install)
src/desktop/dashboard-ui/dist/
src/desktop/dashboard-ui/node_modules/
src/studio/dist/
src/studio/node_modules/

